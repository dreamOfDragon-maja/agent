# 应用配置
APP_NAME=shopmate-agent
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8001

# 日志配置
LOGGING_LEVEL=INFO

# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=shopmate
DB_USER=shopmate
DB_PASSWORD=shopmate123

# 模型配置
DEEPSEEK_API_KEY=replace-me
CHAT_MODEL=deepseek-v4-flash

# MinerU（仅在导入 PDF 知识库时需要；Markdown 文档不需要）
MINERU_TOKEN=

# Milvus
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
RAG_COLLECTION=product_knowledge
# 没有 DashScope 凭据时设为 false，跳过 gte-rerank-v2 重排
RAG_RERANK_ENABLED=true

# 登录令牌
JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720
